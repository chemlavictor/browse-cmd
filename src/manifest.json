{
  "manifest_version": 3,
  "name": "browse-cmd",
  "version": "0.1.0",
  "description": "Interface shell dans la page active, pilotable par raccourci clavier (Ctrl+Shift+K).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting"],
  "commands": {
    "toggle-shell": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Ouvrir/fermer le shell"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/state.js",
        "content/commands.js",
        "content/ui.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
